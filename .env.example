# Backend service configuration. Keep these values out of frontend VITE_* variables.
API_PORT="4000"
# Optional Windows desktop bridge. Disabled unless both values are set. Use a
# random token of at least 24 characters; enter it manually in NEXA each session.
NEXA_DESKTOP_BRIDGE_ENABLED="false"
NEXA_DESKTOP_BRIDGE_TOKEN="replace-with-a-long-random-local-pairing-token"
# The only directory the workspace bridge may search, read, or run its fixed
# lint/test/build tasks in. Use an absolute path; leave empty to disable it.
NEXA_DESKTOP_WORKSPACE_ROOT=""
AI_PROVIDER="lmstudio"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:3b"
LMSTUDIO_BASE_URL="http://127.0.0.1:1234/v1"
LMSTUDIO_MODEL="Qwen2.5-Coder-0.5B-Instruct"
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-2.0-flash"

# WEB SEARCH PROVIDER SETTINGS
# Supported providers: duckduckgo, brave, google
WEB_SEARCH_PROVIDER="duckduckgo"
# DuckDuckGo Instant Answer is keyless. It provides summaries and related topics,
# not complete ranked web search results.
# Google Custom Search JSON API credentials. The API key stays server-side.
GOOGLE_CSE_API_KEY="your_google_custom_search_api_key"
GOOGLE_CSE_ID="f6f3634866dca43af"
# Alternative provider if Google API access is unavailable:
WEB_SEARCH_API_KEY="your_brave_api_key"

# Supabase browser client configuration. Only the publishable anon key belongs
# here; never place a service-role key in VITE_* variables.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-publishable-anon-key"
VITE_NEXA_OWNER_USER_ID="your-supabase-owner-user-id"
